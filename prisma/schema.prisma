// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  ADMIN
  MERCHANT
}

enum RpcEndpointType {
  PRIMARY
  FALLBACK
}

enum RpcHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum IncidentSource {
  RPC_HEALTH
}

enum IncidentSeverity {
  WARNING
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  RESOLVED
}

enum IncidentEventType {
  CREATED
  UPDATED
  RESOLVED
}

enum NotificationSource {
  PAYMENT
  WEBHOOK
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
}

enum NotificationType {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_PENDING_TOO_LONG
  WEBHOOK_DELIVERY_FAILED
  WEBHOOK_RECOVERED
}

// User/Merchant
model Merchant {
  id              String        @id @default(cuid())
  businessName    String
  email           String        @unique
  password        String
  walletAddress   String        @unique 
  apiKey          String        @unique @default(uuid()) 
  isActive        Boolean       @default(true)
  emailVerified   Boolean       @default(false)
  role            Role          @default(MERCHANT)
  activationToken String?       @unique
  walletIdentities MerchantWalletIdentity[]
  transactions    Transaction[]
  webhookLogs     WebhookLog[]
  notifications   MerchantNotification[]
  notificationPreference MerchantNotificationPreference?
  webhookUrl      String?
  webhookSecret   String?       @unique 
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model MerchantWalletIdentity {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  walletAddress String   @unique
  isActive      Boolean  @default(true)
  linkedAt      DateTime @default(now())
  unlinkedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([merchantId])
}

model PlatformMaintenance {
  id               String    @id
  enabled          Boolean   @default(false)
  message          String    @default("The system is currently under maintenance. Please try again later.")
  maintenanceEndsAt DateTime?
  updatedById      String?
  updatedByEmail   String?
  updatedAt        DateTime  @updatedAt
}

// Transaction
model Transaction {
  id              String        @id @default(cuid())
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id])
  orderId         String
  amount          Float
  feeAmount       Float?
  netAmount       Float?
  currency        String        @default("SOL")
  status          String        @default("PENDING")
  txSignature     String?       @unique
  customerEmail   String?
  customerReference String?
  customerName    String?
  notes           String?
  successUrl      String?
  cancelUrl       String?
  source          String        @default("PAYMENT_LINK")
  buyerWallet     String?
  walletProvider  String?
  expiresAt       DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP + interval '30 minutes')"))
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Webhook Log
model WebhookLog {
  id              String        @id @default(cuid())
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  event           String
  url             String
  status          Int?
  payload         String
  response        String?
  createdAt       DateTime      @default(now())
}

model RpcHealthLog {
  id                String          @id @default(cuid())
  endpointType      RpcEndpointType
  endpointUrlMasked String
  latencyMs         Int?
  isReachable       Boolean
  httpStatus        Int?
  errorType         String?
  status            RpcHealthStatus
  checkedAt         DateTime
  createdAt         DateTime        @default(now())

  @@index([checkedAt])
  @@index([endpointType, checkedAt])
  @@index([status, checkedAt])
}

model RpcTrafficLog {
  id                         String          @id @default(cuid())
  operation                  String
  runtime                    String
  endpointType               RpcEndpointType
  endpointUrlMasked          String
  usedAt                     DateTime
  failoverFromEndpointMasked String?
  failoverReason             String?
  createdAt                  DateTime        @default(now())

  @@index([usedAt])
  @@index([endpointType, usedAt])
  @@index([failoverFromEndpointMasked, usedAt])
}

model OperationalIncident {
  id                    String              @id @default(cuid())
  source                IncidentSource
  severity              IncidentSeverity
  status                IncidentStatus      @default(ACTIVE)
  dedupKey              String
  title                 String
  summary               String
  startedAt             DateTime
  resolvedAt            DateTime?
  lastObservedAt        DateTime
  healthyStreak         Int                 @default(0)
  primaryEndpointMasked String?
  fallbackEndpointMasked String?
  triggerMetrics        Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  events                OperationalIncidentEvent[]

  @@index([status, lastObservedAt])
  @@index([source, status, lastObservedAt])
  @@index([dedupKey, status])
}

model OperationalIncidentEvent {
  id          String            @id @default(cuid())
  incidentId  String
  incident    OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  eventType   IncidentEventType
  message     String
  createdAt   DateTime          @default(now())

  @@index([incidentId, createdAt])
  @@index([createdAt])
}

model MerchantNotification {
  id         String               @id @default(cuid())
  merchantId String
  merchant   Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type       NotificationType
  source     NotificationSource
  severity   NotificationSeverity @default(INFO)
  title      String
  message    String
  metadata   Json?
  sourceRefId String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, readAt, createdAt])
  @@index([merchantId, severity, createdAt])
  @@index([merchantId, sourceRefId, type, createdAt])
}

model MerchantNotificationPreference {
  id                     String   @id @default(cuid())
  merchantId             String   @unique
  merchant               Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  paymentSuccess         Boolean  @default(true)
  paymentFailed          Boolean  @default(true)
  paymentPendingTooLong  Boolean  @default(true)
  webhookDeliveryFailed  Boolean  @default(true)
  webhookRecovered       Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
